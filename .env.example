# ===== 前端（Taro 构建时注入，TARO_APP_ 前缀会暴露到代码里）=====

# 微信小程序 AppID（Taro 构建时写入 dist/project.config.json）
TARO_APP_ID=touristappid

# 通用 HTTP API 基础域名。
# - 小程序（weapp）：配置为 Vercel 后端域名，如 https://your-app.vercel.app
# - H5 本地开发：http://localhost:3000
# - 若留空：微信端回退到云函数（Taro.cloud），非微信端报错提示
TARO_APP_API_BASE_URL=

# ===== 后端（Vercel Serverless 运行时的环境变量，不会暴露到前端）=====

# Neon / Vercel Postgres 连接串，例如 postgresql://user:pass@ep-xxx.aws.neon.tech/db
DATABASE_URL=

# JWT 签名密钥（生产环境务必使用强随机串）
JWT_SECRET=

# 管理员绑定邀请码
ADMIN_INVITE_CODE=

# 微信小程序 AppID / AppSecret（用于 jscode2session 换取 openid）
# 未配置时后端进入开发模式：openid = dev-<code>，便于 H5/本地联调
WX_APPID=
WX_SECRET=
